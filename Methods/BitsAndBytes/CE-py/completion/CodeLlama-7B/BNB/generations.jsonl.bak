{"task_id": "630629e152e177c0ba46a0d2", "_id": "630629e152e177c0ba46a0d2", "completion": "def retrieve_and_parse_diaspora_webfinger(handle):\nurl = \"https://%s/.well-known/webfinger?resource=acct:%s\" % (handle, handle)\n\tresponse = requests.get(url)\n\tif response.status_code != 200:\n\t\traise Exception(\"Failed to retrieve webfinger document for %s\" % handle)\n\tdata = response.json()\n\tif data[\"links\"][0][\"rel\"] != \"diaspora\":\n\t\traise Exception(\"Not a Diaspora webfinger document for %s\" % handle)\n\treturn data[\"links\"][0]", "generate_results": ["def retrieve_and_parse_diaspora_webfinger(handle):\nurl = \"https://%s/.well-known/webfinger?resource=acct:%s\" % (handle, handle)\n\tresponse = requests.get(url)\n\tif response.status_code != 200:\n\t\traise Exception(\"Failed to retrieve webfinger document for %s\" % handle)\n\tdata = response.json()\n\tif data[\"links\"][0][\"rel\"] != \"diaspora\":\n\t\traise Exception(\"Not a Diaspora webfinger document for %s\" % handle)\n\treturn data[\"links\"][0]"]}
